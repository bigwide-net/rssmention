RSSMENTION_CONFIG=./rssmention.json5
RSSMENTION_VAR=./var
#RSSMENTION_PORT=3040
#RSSMENTION_BASE_URL=http://localhost:3040

# Moderation via OpenRouter
OPENROUTER_API_KEY=<key>

# Development only: allow fetching sources on private addresses (localhost etc.)
#RSSMENTION_ALLOW_PRIVATE_TARGETS=true

# Rate limits (see lib/limits.middleware.ts), e.g.
#LIMITS_MAX_PER_IP_PER_MINUTE=60

# /happy health endpoint secret (@downread/happy-server); 'none' disables auth
HAPPY_SECRET=<secret>
DEBUG=false
